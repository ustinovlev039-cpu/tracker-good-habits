# Backward-compatible copy of .env.example.
# Prefer: cp .env.example .env

# Django
DEBUG=False
SECRET_KEY=change-me-use-a-long-random-value
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TIME_ZONE=Asia/Vladivostok

# PostgreSQL
POSTGRES_DB=habit_tracker
POSTGRES_USER=habit_user
POSTGRES_PASSWORD=change-me-use-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis and Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Telegram integration. Leave both values empty to disable bot polling locally.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Docker Compose
HTTP_PORT=80
IMAGE_TAG=local

# Enable these only after HTTPS works through a trusted reverse proxy.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
